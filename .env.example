# WhatsApp Group JID (format: groupname@g.us)
# To get your group JID, add the bot to the group and check logs
GROUP_JID=

# Cron schedule for weekly event (default: every Friday at 6 PM)
# Use https://crontab.guru/ to create your schedule
CRON_SCHEDULE=0 18 * * 5

# Event details
EVENT_TITLE=Friday Pizza Night
EVENT_MESSAGE=Who's up for pizza this Friday? 🍕
