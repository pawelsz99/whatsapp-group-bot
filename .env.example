# WhatsApp Group JID
GROUP_JID=

# Cron schedule for weekly event (when bot creates the event)
# Examples: 0 11 * * 3 = Wed at 11:00, 0 18 * * 5 = Fri at 18:00
CRON_SCHEDULE=0 11 * * 3

# Weekly event details
WEEKLY_EVENT_NAME=Weekly Event
WEEKLY_EVENT_DESCRIPTION=Join us this week!

# Event start time (hour and minute)
WEEKLY_EVENT_HOUR=19
WEEKLY_EVENT_MINUTE=0

# Event end time (optional - leave empty to skip)
WEEKLY_EVENT_END_HOUR=21
WEEKLY_EVENT_END_MINUTE=0
